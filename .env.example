# Supabase. Localmente: rode `npx supabase start` e copie os valores de `npx supabase status`.
# Sem estas variáveis o site roda com os aparelhos de exemplo e o painel fica fechado.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço: só no servidor. Usada para criar logins na tela de Acessos.
SUPABASE_SERVICE_ROLE_KEY=
